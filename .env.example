# LiteLLM unified model routing (swap providers without code changes)
# Examples:
#   Gemini:   LLM_MODEL=gemini/gemini-3.5-flash-lite
#   DeepSeek: LLM_MODEL=openai/deepseek-flash  +  LLM_BASE_URL=https://api.deepseek.com
#   OpenAI:   LLM_MODEL=openai/gpt-4o-mini
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_RETRY_MODEL=gemini/gemini-3.5-flash-lite
LLM_BASE_URL=
LLM_API_KEY=your_api_key_here

# Optional local secrets file fallback when LLM_API_KEY is blank
SECRETS_ENV_PATH=

# Extraction throughput and rendering
LLM_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=4096
PDF_RENDER_DPI=200

# Optional USD pricing per 1M tokens for run-level cost reporting (Gemini 3.5 Flash-Lite list rates)
LLM_INPUT_PRICE_PER_MILLION_USD=0.30
LLM_OUTPUT_PRICE_PER_MILLION_USD=2.50

# Deterministic reconciliation policy
TOLERANCE_IDR=10
TAX_BASE_ERROR_AS_NEEDS_REVIEW=true

# Optional content-addressed disk cache directory (leave blank to disable)
EXTRACTION_CACHE_DIR=

# Lightweight HTTP API guards (in-memory single-process sliding window and upload size caps)
RATE_LIMIT_REQUESTS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_PDF_UPLOAD_MB=25
MAX_ERP_UPLOAD_MB=10
