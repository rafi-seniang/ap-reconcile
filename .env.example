# LiteLLM unified model routing (swap or pair providers without code changes)
# Examples:
#   Gemini:   gemini/gemini-3.5-flash-lite
#   DeepSeek: deepseek/deepseek-flash
#   OpenAI:   openai/gpt-4o-mini
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_RETRY_MODEL=gemini/gemini-3.5-flash-lite

# Optional automatic failover model (activates when set and its provider API key is present)
LLM_FALLBACK_MODEL=deepseek/deepseek-flash

# Provider API keys (fill whichever provider(s) you use; LLM_API_KEY also works as a generic override)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional custom base URLs for self-hosted / OpenAI-compatible gateways
LLM_BASE_URL=
LLM_FALLBACK_BASE_URL=

# Optional local secrets file fallback when provider keys above are blank
SECRETS_ENV_PATH=

# Sampling, reasoning effort (none | minimal | low | medium | high), retries, throughput, and rendering
LLM_TEMPERATURE=0.0
LLM_REASONING_EFFORT=none
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=4096
PDF_RENDER_DPI=200

# Optional USD pricing per 1M tokens for run-level cost reporting (Gemini 3.5 Flash-Lite list rates)
LLM_INPUT_PRICE_PER_MILLION_USD=0.30
LLM_OUTPUT_PRICE_PER_MILLION_USD=2.50

# Deterministic reconciliation policy
TOLERANCE_IDR=10
TAX_BASE_ERROR_AS_NEEDS_REVIEW=true

# Optional content-addressed disk cache directory (leave blank to disable)
EXTRACTION_CACHE_DIR=

# Lightweight HTTP API guards and in-memory run retention
RATE_LIMIT_REQUESTS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_PDF_UPLOAD_MB=25
MAX_ERP_UPLOAD_MB=10
MAX_STORED_RUNS=10
