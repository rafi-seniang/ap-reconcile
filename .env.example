# Provider: "gemini" (native PDF via google-genai) or "openai_compat" (PNG vision via OpenAI SDK, e.g. DeepSeek / OpenAI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_RETRY_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=
LLM_API_KEY=

# Optional local shared secrets file (never committed). Used only when LLM_API_KEY is empty.
SECRETS_ENV_PATH=

# Concurrency, retry, and rendering settings
LLM_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=4096
PDF_RENDER_DPI=200

# Optional token prices (USD per 1M tokens) for cost reporting; leave empty if unknown
LLM_INPUT_PRICE_PER_MILLION_USD=0.30
LLM_OUTPUT_PRICE_PER_MILLION_USD=2.50
LLM_RETRY_INPUT_PRICE_PER_MILLION_USD=0.30
LLM_RETRY_OUTPUT_PRICE_PER_MILLION_USD=2.50

# Business rules (R1-R8)
TOLERANCE_IDR=10
TAX_BASE_ERROR_AS_NEEDS_REVIEW=true

# Optional disk cache directory for repeated local runs (empty disables cache)
EXTRACTION_CACHE_DIR=
